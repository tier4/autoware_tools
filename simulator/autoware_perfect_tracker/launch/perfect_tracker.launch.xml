<launch>
  <arg name="n_delay_steps" default="0" description="Number of trajectory messages to delay"/>
  <arg
    name="tracker_mode"
    default="snap"
    description="Ego-advance algorithm: 'snap' (follow the model prediction by plan index) or 'physics' (conventional SPS-mimic: nearest point + velocity Euler)"
  />
  <arg name="replan_interval" default="1" description="Adopt a fresh plan every this many 0.1s steps; hold and advance the plan index in between (snap mode; 1 = follow the latest plan each update)"/>
  <arg name="initial_engage_state" default="false" description="If false, the vehicle is held in place until it is engaged (/autoware/engage)"/>

  <node pkg="autoware_perfect_tracker" exec="perfect_tracker_node" name="perfect_tracker" namespace="simulation" output="screen">
    <remap from="input/trajectory" to="/planning/trajectory_generator/neural_network_based_planner/diffusion_planner_node/output/trajectory"/>
    <remap from="input/turn_indicators_command" to="/control/command/turn_indicators_cmd"/>
    <remap from="input/hazard_lights_command" to="/control/command/hazard_lights_cmd"/>
    <remap from="input/gear_command" to="/control/command/gear_cmd"/>
    <remap from="input/initialpose" to="/initialpose3d"/>
    <remap from="input/initialtwist" to="/initialtwist"/>

    <remap from="output/odometry" to="/localization/kinematic_state"/>
    <remap from="output/twist" to="/vehicle/status/velocity_status"/>
    <remap from="output/steering" to="/vehicle/status/steering_status"/>
    <remap from="output/acceleration" to="/localization/acceleration"/>
    <remap from="output/imu" to="/sensing/imu/imu_data"/>
    <remap from="output/control_mode_report" to="/vehicle/status/control_mode"/>
    <remap from="output/gear_report" to="/vehicle/status/gear_status"/>
    <remap from="output/turn_indicators_report" to="/vehicle/status/turn_indicators_status"/>
    <remap from="output/hazard_lights_report" to="/vehicle/status/hazard_lights_status"/>
    <remap from="output/pose" to="/simulation/debug/pose"/>

    <param name="simulated_frame_id" value="base_link"/>
    <param name="origin_frame_id" value="map"/>
    <param name="n_delay_steps" value="$(var n_delay_steps)"/>
    <param name="tracker_mode" value="$(var tracker_mode)"/>
    <param name="replan_interval" value="$(var replan_interval)"/>
    <param name="initial_engage_state" value="$(var initial_engage_state)"/>
  </node>
</launch>
