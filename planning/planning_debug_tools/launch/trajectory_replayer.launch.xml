<launch>
  <!--
    Launch file for the trajectory replayer tool.
    Starts the trajectory modifier + optimizer nodes with default params,
    plus the matplotlib comparison script.

    Usage:
      Terminal 1: ros2 launch planning_debug_tools trajectory_replayer.launch.xml
      Terminal 2: ros2 run planning_debug_tools trajectory_replayer -b /path/to/rosbag

    For optimizer-only mode (skip modifier, replay modifier output directly):
      Terminal 2: ros2 run planning_debug_tools trajectory_replayer -b /path/to/rosbag -m optimizer

    For modifier mode (replay diffusion planner output, run both modifier + optimizer):
      Terminal 2: ros2 run planning_debug_tools trajectory_replayer -b /path/to/rosbag -m modifier
  -->

  <arg name="mode" default="optimizer" description="modifier or optimizer"/>
  <arg name="vehicle_info_param_path" default="$(find-pkg-share j6_gen2_description)/config/vehicle_info.param.yaml"/>

  <!-- velocity smoother parameter blackboard (required by optimizer) -->
  <node pkg="demo_nodes_cpp" exec="parameter_blackboard" name="velocity_smoother" namespace="/planning/scenario_planning" output="screen">
    <param name="max_velocity" value="16.6"/>
  </node>

  <!-- trajectory modifier param paths -->
  <arg name="trajectory_modifier_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/trajectory_modifier.param.yaml"/>

  <!-- trajectory optimizer param paths -->
  <arg name="trajectory_optimizer_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/trajectory_optimizer.param.yaml"/>
  <arg name="elastic_band_param_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/lane_driving/motion_planning/path_smoother/elastic_band_smoother.param.yaml"/>
  <arg name="common_param_path" default="$(find-pkg-share autoware_launch)/config/planning/scenario_planning/common/common.param.yaml"/>
  <arg name="trajectory_point_fixer_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/trajectory_optimizer_plugins/trajectory_point_fixer.param.yaml"/>
  <arg name="trajectory_extender_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/trajectory_optimizer_plugins/trajectory_extender.param.yaml"/>
  <arg name="trajectory_spline_smoother_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/trajectory_optimizer_plugins/trajectory_spline_smoother.param.yaml"/>
  <arg name="trajectory_qp_smoother_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/trajectory_optimizer_plugins/trajectory_qp_smoother.param.yaml"/>
  <arg name="trajectory_velocity_optimizer_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/trajectory_optimizer_plugins/trajectory_velocity_optimizer.param.yaml"/>
  <arg name="trajectory_kinematic_feasibility_enforcer_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/trajectory_optimizer_plugins/trajectory_kinematic_feasibility_enforcer.param.yaml"/>
  <arg name="trajectory_mpt_optimizer_param_path" default="$(find-pkg-share autoware_launch)/config/planning/neural_net_planner/trajectory_optimizer_plugins/trajectory_mpt_optimizer.param.yaml"/>

  <group>
    <push-ros-namespace namespace="planning/trajectory_generator/neural_network_based_planner"/>

    <!-- trajectory modifier (only in modifier mode) -->
    <group if="$(eval &quot;'$(var mode)' == 'modifier'&quot;)">
      <node pkg="autoware_trajectory_modifier" exec="autoware_trajectory_modifier_node" name="trajectory_modifier" output="screen">
        <param from="$(var vehicle_info_param_path)"/>
        <param from="$(var trajectory_modifier_param_path)"/>
        <param name="launch_modules" value="[autoware::trajectory_modifier::plugin::ObstacleStop, autoware::trajectory_modifier::plugin::StopPointFixer]"/>
        <remap from="~/input/candidate_trajectories" to="/planning/generator/diffusion_planner/candidate_trajectories"/>
        <remap from="~/output/candidate_trajectories" to="/planning/generator/diffusion_planner/modified_candidate_trajectories"/>
        <remap from="~/input/odometry" to="/localization/kinematic_state"/>
        <remap from="~/input/acceleration" to="/localization/acceleration"/>
        <remap from="~/input/objects" to="/perception/object_recognition/objects"/>
        <remap from="~/input/pointcloud" to="/perception/obstacle_segmentation/pointcloud"/>
      </node>
    </group>

    <!-- trajectory optimizer (always) -->
    <node pkg="autoware_trajectory_optimizer" exec="autoware_trajectory_optimizer_node" name="trajectory_optimizer_node" output="screen">
      <param from="$(var vehicle_info_param_path)"/>
      <param from="$(var trajectory_optimizer_param_path)" allow_substs="true"/>
      <param from="$(var common_param_path)"/>
      <param from="$(var elastic_band_param_path)" allow_substs="true"/>
      <param from="$(var trajectory_point_fixer_param_path)" allow_substs="true"/>
      <param from="$(var trajectory_extender_param_path)" allow_substs="true"/>
      <param from="$(var trajectory_spline_smoother_param_path)" allow_substs="true"/>
      <param from="$(var trajectory_qp_smoother_param_path)" allow_substs="true"/>
      <param from="$(var trajectory_velocity_optimizer_param_path)" allow_substs="true"/>
      <param from="$(var trajectory_kinematic_feasibility_enforcer_param_path)" allow_substs="true"/>
      <param from="$(var trajectory_mpt_optimizer_param_path)" allow_substs="true"/>
      <remap from="~/output/trajectory" to="/planning/generator/trajectory_optimizer/debug/trajectory"/>
      <remap from="~/output/trajectories" to="/planning/generator/candidate_trajectories"/>
      <remap from="~/output/current_velocity_limit_mps" to="/planning/scenario_planning/current_max_velocity"/>
      <remap from="~/input/trajectories" to="/planning/generator/diffusion_planner/modified_candidate_trajectories"/>
      <remap from="~/input/traj" to="/planning/generator/diffusion_planner/trajectory"/>
      <remap from="~/input/external_velocity_limit_mps" to="/planning/scenario_planning/max_velocity_default"/>
      <remap from="~/input/odometry" to="/localization/kinematic_state"/>
      <remap from="~/input/acceleration" to="/localization/acceleration"/>
    </node>
  </group>

  <!-- matplotlib comparison visualization -->
  <node pkg="planning_debug_tools" exec="trajectory_comparison.py" name="trajectory_comparison" output="screen"/>
</launch>
